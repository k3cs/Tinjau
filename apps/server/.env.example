# Copy to .env and fill in real values. Never commit .env itself.

# SEC requires a descriptive User-Agent identifying the requester on every EDGAR request.
# Format SEC asks for: "<company/project name> <contact email>". See SERVICES.md SVC-001.
EDGAR_USER_AGENT="AFTERHOURS research@example.com"

# Optional: override the default 5-minute EDGAR poll interval (milliseconds, min 30000).
# EDGAR_POLL_INTERVAL_MS=300000

# Gemini API key (task P0.13, SERVICES.md SVC-004). Any one of these three names works;
# GEMINI_API_KEY is checked first. NOT currently set in this environment.
GEMINI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_API_KEY=

# Optional: override the default Gemini model id (defaults to gemini-3.6-flash, "Flash tier",
# pinned in src/llm/provider.ts). Leaving this unset is the pinned, intended configuration;
# setting it changes which model produced any output recorded downstream, so any published
# result must name the id it actually ran under.
# GEMINI_MODEL=gemini-3.6-flash

# --- P1.8: on-chain posting (src/chain/*) ---

# Private key of the address authorized as EventStateRegistry.poster(). Required to post.
POSTER_PRIVATE_KEY=

# Optional: override the X Layer Testnet RPC URL (default https://testrpc.xlayer.tech).
# XLAYER_TESTNET_RPC_URL=https://testrpc.xlayer.tech

# Optional: override the deployed EventStateRegistry address on X Layer Testnet.
# EVENT_STATE_REGISTRY_ADDRESS=0x713f45f44e74616898FB366E11881196221933aA

# Optional: override the default bond amount in human USD₮0 units (default 10).
# BOND_AMOUNT_USDT0=10

# Optional: per-symbol testnet token address override (see src/chain/tokenAddresses.ts),
# e.g. NVDAX_TESTNET_ADDRESS=0xf07A9D89848bc694c7154Fda4cce707Eb409F903
# NVDAX_TESTNET_ADDRESS=
# MSTRX_TESTNET_ADDRESS=

# --- P4.4: synthetic-injection test + swaps against the P4.2 demo pool (src/chain/*) ---

# Private key of the demo-relayer account. ALL swaps (src/chain/swapOnce.ts) sign with
# this key, never POSTER_PRIVATE_KEY — proves a non-poster third party pays the widened
# fee (matches the eventual P6.2 relayer pattern) and keeps the poster's OKB reserved for
# registry-posting gas only.
DEMO_RELAYER_PRIVATE_KEY=

# Optional: override the deployed v4 PoolManager address (default is the live P0.5 deploy).
# POOL_MANAGER=0x8F862A8b6f00C99b0610dc764228C661c4909ae1

# Optional: override the deployed AfterhoursFeeHook address (default is the live P4.2 deploy).
# TINJAU_HOOK_ADDRESS=0xbCb4B7310BA36eA01f2A435A5D64C9b7953d8080

# Optional: override the mock wNVDAx address, 18 decimals (default is the live P4.2 deploy).
# MOCK_WNVDAX=0xf07A9D89848bc694c7154Fda4cce707Eb409F903

# Optional: override the mock USDG address, 6 decimals (default is the live P4.2 deploy).
# MOCK_USDG=0x666e81CCb9D4d6c2e7A3ed9f317E3dFBa2410e99

# Deployed PoolSwapTest router (P4.4 — run contracts/script/DeployTestnetSwapRouter.s.sol
# first, then set this to the address it prints). No hardcoded default: none existed
# before this task, only PoolModifyLiquidityTest (P4.2's liquidity-seeding router).
# POOL_SWAP_ROUTER=

# --- P5.3: X bot posting every parsed event (src/xbot/*) ---

# "dry-run" (default) or "live". In dry-run, no X_* credential is read/required at all.
# TINJAU_XBOT_POST_MODE=dry-run

# Optional: override the default 60s poll interval (milliseconds, min 30000).
# TINJAU_XBOT_POLL_INTERVAL_MS=60000

# Required ONLY when TINJAU_XBOT_POST_MODE=live — OAuth 1.0a User Context credentials
# for POST https://api.x.com/2/tweets. Not set anywhere in this project yet (P0.1, creating
# the real X developer account, is a separate human-only task not yet done).
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
