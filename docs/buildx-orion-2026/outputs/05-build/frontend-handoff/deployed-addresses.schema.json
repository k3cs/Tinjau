{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinjau.xyz/schemas/deployed-addresses/1.0.0.json",
  "title": "Tinjau DeployedAddresses",
  "description": "Chain id, contract role, address, bytecode check and relevant transaction hashes (tracker §0.23 item 9). Two stacks are deployed because X Layer Testnet has no evm_increaseTime. The schema pins the facts a consumer must not lose: the addresses are NOT final, everything is a testnet, every contract carries a bytecode check, and the stale-read warning travels with the RPC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "statusText",
    "network",
    "bytecodeVerification",
    "whyTwoStacks",
    "stacks",
    "accounts",
    "historical",
    "canonicalMainnetReferences",
    "notRecorded"
  ],
  "properties": {
    "schemaVersion": { "const": "tinjau.deployed-addresses/1.0.0" },
    "status": {
      "const": "T7_2_AUTHORITATIVE",
      "description": "Constrained. T7.2 owns the authoritative list; promoting these to final requires that task and a schema version bump, not a string edit."
    },
    "statusText": { "type": "string", "minLength": 1 },

    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chainId", "name", "rpc", "isTestnet", "supportsTimeTravel", "rpcWarning"],
      "properties": {
        "chainId": {
          "const": 1952,
          "description": "X Layer TESTNET. No mainnet address may be published from this document."
        },
        "name": { "type": "string", "minLength": 1 },
        "rpc": { "type": "string", "minLength": 1 },
        "isTestnet": { "const": true },
        "supportsTimeTravel": {
          "const": false,
          "description": "No evm_increaseTime. This is why two stacks exist."
        },
        "rpcWarning": {
          "type": "string",
          "minLength": 1,
          "pattern": "[Ss][Tt][Aa][Ll][Ee] [Rr][Ee][Aa][Dd][Ss]",
          "description": "Pattern-constrained so it cannot be softened away. A consumer polling currentRecord on this RPC can read NORMAL while a PROTECT is live — the dangerous direction for a risk registry."
        }
      }
    },

    "bytecodeVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "rpc", "atBlockNumber", "atIso", "note"],
      "properties": {
        "method": { "const": "eth_getCode(address, 'latest')" },
        "rpc": { "type": "string", "minLength": 1 },
        "atBlockNumber": { "type": "integer", "minimum": 1 },
        "atIso": { "type": "string", "format": "date-time" },
        "note": { "type": "string", "minLength": 1 }
      }
    },

    "whyTwoStacks": { "type": "string", "minLength": 1 },

    "stacks": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stackId",
          "label",
          "isDemoEnvelope",
          "envelope",
          "poolId",
          "tickSpacing",
          "contracts",
          "transactions",
          "manifest"
        ],
        "properties": {
          "stackId": { "enum": ["production-envelope", "demo-envelope"] },
          "label": { "type": "string", "minLength": 1 },
          "isDemoEnvelope": { "type": "boolean" },
          "envelope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "baseFee",
              "maxFee",
              "widenDuration",
              "decayDuration",
              "maxProtectDuration",
              "cooldown",
              "demoEnvelope"
            ],
            "properties": {
              "baseFee": { "const": 500 },
              "maxFee": { "const": 20000 },
              "widenDuration": { "type": "integer", "minimum": 1 },
              "decayDuration": { "type": "integer", "minimum": 1 },
              "maxProtectDuration": { "type": "integer", "minimum": 1 },
              "cooldown": { "type": "integer", "minimum": 1 },
              "demoEnvelope": { "type": "boolean" }
            }
          },
          "poolId": { "$ref": "#/$defs/bytes32" },
          "tickSpacing": { "type": "integer" },
          "contracts": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/contract" }
          },
          "transactions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "txHash", "scene"],
              "properties": {
                "label": { "type": "string", "minLength": 1 },
                "txHash": { "$ref": "#/$defs/txHashOrNull" },
                "scene": { "type": "string", "minLength": 1 }
              }
            }
          },
          "manifest": { "type": "string", "minLength": 1 }
        }
      }
    },

    "accounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessor", "poster", "relayer", "guardian"],
      "description": "Addresses only. No key material may appear in this file or anywhere in the handoff directory.",
      "properties": {
        "assessor": { "$ref": "#/$defs/account" },
        "poster": { "$ref": "#/$defs/account" },
        "relayer": { "$ref": "#/$defs/account" },
        "guardian": { "$ref": "#/$defs/account" }
      }
    },

    "historical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["note", "chainId", "contracts"],
      "description": "The AFTERHOURS contracts. Genuinely deployed, genuinely named that, and NOT the current system (§0.18).",
      "properties": {
        "note": { "type": "string", "minLength": 1 },
        "chainId": { "const": 1952 },
        "contracts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "address", "hasBytecode", "codeSize"],
            "properties": {
              "role": { "type": "string", "minLength": 1 },
              "address": { "$ref": "#/$defs/address" },
              "hasBytecode": { "type": "boolean" },
              "codeSize": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },

    "canonicalMainnetReferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["note", "chainId", "wNVDAx", "liquiditySource"],
      "description": "NOT deployed by this project. Present so nobody confuses the testnet mocks with the real chain-196 asset they stand in for.",
      "properties": {
        "note": { "type": "string", "minLength": 1 },
        "chainId": { "const": 196 },
        "wNVDAx": { "$ref": "#/$defs/address" },
        "referencePoolFirstBlockWithBytecode": { "type": "integer" },
        "referencePoolFirstBlockIso": { "type": "string", "minLength": 1 },
        "liquiditySource": { "const": "THIRD_PARTY" }
      }
    },

    "notRecorded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "reason", "howToGet"],
        "description": "What this document does NOT carry, and why. An unexplained absence reads as an oversight; a stated one is a limitation.",
        "properties": {
          "item": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "howToGet": { "type": "string", "minLength": 1 }
        }
      }
    }
  },

  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "bytes32": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "txHashOrNull": { "type": ["string", "null"], "pattern": "^0x[0-9a-fA-F]{64}$" },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "address", "hasBytecode", "codeSize", "isBuilderControlled", "note"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "address": { "$ref": "#/$defs/address" },
        "hasBytecode": {
          "const": true,
          "description": "§0.23 requires a bytecode check. An address with no code is not a deployment and does not belong in this list."
        },
        "codeSize": {
          "type": "integer",
          "minimum": 1,
          "description": "Bytes returned by eth_getCode. Required — a boolean alone would not let a reader detect a redeploy."
        },
        "isBuilderControlled": { "type": "boolean" },
        "note": { "type": ["string", "null"] }
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "role", "disclosure"],
      "properties": {
        "address": { "$ref": "#/$defs/address" },
        "role": { "type": "string", "minLength": 1 },
        "disclosure": { "type": ["string", "null"] }
      }
    }
  }
}
