{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinjau.xyz/schemas/scenario-result/1.0.0.json",
  "title": "Tinjau ScenarioResult",
  "description": "One end-to-end scenario outcome: the §0.24 risk record, the evidence graph behind it, the on-chain steps that were actually executed, and the limitations that bound what it may be used to claim. `scenario-rumor-watch.json` and `scenario-confirmed-protect.json` are the two instances. The schema's job is not to check the numbers — it is to make it structurally impossible to publish a CONSTRUCTED outcome without the caveat that says so.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scenarioId",
    "role",
    "title",
    "producedBy",
    "provenance",
    "window",
    "record",
    "evidenceGraph",
    "ruleVersions",
    "derived",
    "onChain",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": "tinjau.scenario-result/1.0.0" },
    "scenarioId": { "type": "string", "minLength": 1 },
    "role": {
      "enum": ["RUMOUR_NEGATIVE_CONTROL", "CONFIRMED_EVENT_BOUNDED_ACTION_AND_RECOVERY"]
    },
    "title": { "type": "string", "minLength": 1 },
    "producedBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks", "generator", "modules"],
      "properties": {
        "tasks": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "generator": { "type": "string", "minLength": 1 },
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "The production modules this result came from. Nothing here is hand-written; a reader can re-run it."
        }
      }
    },

    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence",
        "marketLeg",
        "marketVenue",
        "outcomeOrigin",
        "preRegistered",
        "preRegisteredOutcome",
        "matchesPreRegistration"
      ],
      "properties": {
        "evidence": {
          "enum": ["REPLAYED_SOURCE_LINKED", "SIMULATED", "LIVE"],
          "description": "Where the EVIDENCE came from. Independent of where the market data came from — the two legs can differ, and in scenario B they do."
        },
        "marketLeg": {
          "enum": ["REPLAYED", "CONSTRUCTED", "LIVE", "UNAVAILABLE"],
          "description": "CONSTRUCTED means the price path was built by this project, not observed. It is a different fact from the evidence leg's provenance and must never be collapsed into it."
        },
        "marketVenue": { "type": "string", "minLength": 1 },
        "outcomeOrigin": {
          "enum": ["CANONICAL_REPLAY", "CONSTRUCTED_MARKET_INPUTS", "LIVE"],
          "description": "The single most important field in this file. CANONICAL_REPLAY means the outcome is what real data produced. CONSTRUCTED_MARKET_INPUTS means it is not, and the `criticalCaveat` block below becomes REQUIRED."
        },
        "preRegistered": { "type": "boolean" },
        "preRegisteredOutcome": { "type": "string", "minLength": 1 },
        "matchesPreRegistration": { "type": "boolean" }
      }
    },

    "criticalCaveat": { "$ref": "#/$defs/criticalCaveat" },

    "window": {
      "type": "object",
      "required": ["chainId", "pool", "swapCount"],
      "properties": {
        "chainId": { "type": "integer" },
        "pool": { "type": "string", "minLength": 1 },
        "fromBlock": { "type": "integer" },
        "toBlock": { "type": "integer" },
        "fromIso": { "type": "string", "minLength": 1 },
        "toIso": { "type": "string", "minLength": 1 },
        "swapCount": { "type": "integer", "minimum": 0 },
        "rpcRangeErrors": { "type": "integer", "minimum": 0 },
        "liquiditySource": { "enum": ["BUILDER_CONTROLLED", "THIRD_PARTY"] },
        "construction": {
          "type": "object",
          "description": "Present only for a CONSTRUCTED window. It is the exact recipe, so the path can be rebuilt and re-scored by a stranger.",
          "required": ["openPrice", "fallBps", "fallSeconds", "holdSeconds", "intervalSeconds"],
          "properties": {
            "openPrice": { "type": "number" },
            "fallBps": { "type": "integer" },
            "fallSeconds": { "type": "integer" },
            "holdSeconds": { "type": "integer" },
            "intervalSeconds": { "type": "integer" },
            "note": { "type": "string" }
          }
        }
      }
    },

    "record": {
      "$ref": "risk-record.schema.json",
      "description": "The §0.24 view model, validated against the published risk-record schema rather than a copy of it."
    },
    "evidenceGraph": {
      "$ref": "evidence-graph.schema.json",
      "description": "The claim/provenance/relationship structure the state was derived from."
    },

    "ruleVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "policy", "confirmation", "evidenceCommitment", "assessmentId"],
      "properties": {
        "schema": { "type": "string", "minLength": 1 },
        "policy": { "type": "string", "minLength": 1 },
        "confirmation": { "type": "string", "minLength": 1 },
        "evidenceCommitment": { "type": "string", "minLength": 1 },
        "assessmentId": { "type": "string", "minLength": 1 }
      }
    },

    "derived": {
      "type": "object",
      "required": ["postable", "policyTargetFee", "effectiveConfirmation"],
      "properties": {
        "postable": { "type": "boolean" },
        "policyTargetFee": { "type": "integer", "minimum": 0 },
        "effectiveConfirmation": {
          "enum": ["CONFIRMED", "NOT_CONFIRMED", "UNAVAILABLE", "STALE"]
        },
        "independentOriginCount": { "type": "integer", "minimum": 0 },
        "usableOriginCount": {
          "type": "integer",
          "minimum": 0,
          "description": "THIS is the number the promotion rules count. A UI showing independentOriginCount beside a WATCH makes a precisely-reasoned decision look arbitrary."
        },
        "protectStartedAt": { "type": ["integer", "null"] },
        "remainingProtectSec": { "type": ["integer", "null"] }
      }
    },

    "onChain": {
      "type": "object",
      "required": [
        "status",
        "addressStatus",
        "chainId",
        "networkLabel",
        "registry",
        "hook",
        "poolId",
        "steps",
        "passed"
      ],
      "properties": {
        "status": { "const": "POSTED_ON_X_LAYER_TESTNET" },
        "addressStatus": {
          "type": "string",
          "pattern": "builder-controlled",
          "description": "Pattern-constrained so the label cannot be quietly dropped. This pattern used to require 'not final', which was correct until T7.2 verified the list and then began enforcing a false statement. The fact that must survive every rewrite is that the pools are BUILDER-CONTROLLED test liquidity, so that is what is pinned now."
        },
        "chainId": {
          "const": 1952,
          "description": "X Layer TESTNET. Constrained so a mainnet value cannot appear here by edit."
        },
        "networkLabel": { "type": "string", "minLength": 1 },
        "registry": { "$ref": "#/$defs/address" },
        "hook": { "$ref": "#/$defs/address" },
        "poolId": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "envelope": { "type": "object" },
        "envelopeNote": { "type": "string" },
        "assetRemap": {
          "type": "object",
          "required": ["canonicalAsset", "deployedStandIn", "chainId", "note"],
          "properties": {
            "canonicalAsset": { "$ref": "#/$defs/address" },
            "deployedStandIn": { "$ref": "#/$defs/address" },
            "chainId": { "type": "integer" },
            "note": { "type": "string", "minLength": 1 }
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["step", "atUnixSeconds", "txHash", "note"],
            "properties": {
              "step": { "type": "string", "minLength": 1 },
              "atUnixSeconds": { "type": "integer" },
              "txHash": { "$ref": "#/$defs/txHashOrNull" },
              "note": { "type": "string", "minLength": 1 }
            }
          }
        },
        "chargedFees": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["txHash", "appliedFee", "source"],
            "properties": {
              "txHash": { "$ref": "#/$defs/txHashOrNull" },
              "blockNumber": { "type": "integer" },
              "appliedFee": { "type": "integer", "minimum": 0 },
              "previewedFee": { "type": "integer", "minimum": 0 },
              "source": { "type": "string", "minLength": 1 }
            }
          }
        },
        "passed": { "type": "boolean" }
      }
    },

    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorizedByEvidence", "requestedFeePips", "appliedFeePips", "appliedTxHash", "feeSource"],
      "properties": {
        "authorizedByEvidence": { "type": "boolean" },
        "requestedFeePips": { "type": ["string", "null"] },
        "appliedFeePips": { "type": ["string", "null"] },
        "appliedTxHash": { "$ref": "#/$defs/txHashOrNull" },
        "feeSource": {
          "type": "string",
          "minLength": 1,
          "description": "Where the applied fee was read from. 'PoolManager Swap event' is the difference between demonstrating enforcement and demonstrating a getter."
        }
      }
    },

    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "keeperTransactionRequired",
        "llmInvolved",
        "measured",
        "previewIsUpperBound",
        "storedVsEffective",
        "cooldown"
      ],
      "properties": {
        "method": { "const": "DETERMINISTIC_TIME_DECAY" },
        "keeperTransactionRequired": { "const": false },
        "llmInvolved": { "const": false },
        "measured": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "atUnixSeconds", "appliedFee", "previewedFee", "txHash"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "atUnixSeconds": { "type": "integer" },
              "appliedFee": { "type": "integer", "minimum": 0 },
              "previewedFee": { "type": "integer", "minimum": 0 },
              "txHash": { "$ref": "#/$defs/txHashOrNull" }
            }
          }
        },
        "previewIsUpperBound": { "type": "string", "minLength": 1 },
        "storedVsEffective": { "type": "string", "minLength": 1 },
        "cooldown": {
          "type": "object",
          "additionalProperties": false,
          "required": ["seconds", "provenOnChain", "evidence"],
          "properties": {
            "seconds": { "type": "integer", "minimum": 0 },
            "provenOnChain": { "type": "boolean" },
            "evidence": { "type": "string", "minLength": 1 }
          }
        }
      }
    },

    "failedActionCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene", "purpose", "inducedBy", "actionStatus", "feeAfterFailure", "steps"],
      "description": "§0.11: an action failure is recorded WITHOUT claiming a protection benefit.",
      "properties": {
        "scene": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "inducedBy": { "type": "string", "minLength": 1 },
        "actionStatus": { "const": "FAILED" },
        "feeAfterFailure": { "type": "integer", "minimum": 0 },
        "feeAfterFailureTxHash": { "$ref": "#/$defs/txHashOrNull" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["step", "atUnixSeconds", "txHash", "note"],
            "properties": {
              "step": { "type": "string", "minLength": 1 },
              "atUnixSeconds": { "type": "integer" },
              "txHash": { "$ref": "#/$defs/txHashOrNull" },
              "note": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },

    "limitations": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string", "minLength": 1 },
      "description": "Non-empty by construction. Every scenario in this project has real limitations, and an empty list would be a false statement rather than a tidy one."
    }
  },

  "if": {
    "type": "object",
    "properties": {
      "provenance": {
        "type": "object",
        "properties": { "outcomeOrigin": { "const": "CONSTRUCTED_MARKET_INPUTS" } },
        "required": ["outcomeOrigin"]
      }
    },
    "required": ["provenance"]
  },
  "then": {
    "required": ["criticalCaveat", "action", "recovery"],
    "properties": {
      "provenance": {
        "properties": { "marketLeg": { "const": "CONSTRUCTED" } }
      }
    },
    "description": "A constructed outcome MUST carry the caveat naming what the canonical replay actually resolves to, and its market leg must say CONSTRUCTED. Relabelling one without the other is the exact misrepresentation this schema exists to block."
  },
  "else": {
    "not": { "required": ["criticalCaveat"] },
    "description": "The other half of the biconditional. A document carrying a criticalCaveat while claiming CANONICAL_REPLAY is rejected too — otherwise the constructed artifact could be relabelled a replay by editing one field and the caveat would just sit there, ignored."
  },

  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "txHashOrNull": { "type": ["string", "null"], "pattern": "^0x[0-9a-fA-F]{64}$" },
    "criticalCaveat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headline",
        "text",
        "canonicalReplayState",
        "canonicalReplayConfirmation",
        "canonicalReplayReasonCodes",
        "reasonCodeDiff",
        "uiRequirement"
      ],
      "properties": {
        "headline": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "canonicalReplayState": {
          "enum": ["NORMAL", "WATCH"],
          "description": "Deliberately EXCLUDES PROTECT. Tinjau reaches PROTECT on none of the four frozen replay scenarios, so a canonical replay state of PROTECT in this field would be false. If that ever changes, version this schema rather than editing it."
        },
        "canonicalReplayConfirmation": {
          "enum": ["NOT_CONFIRMED", "UNAVAILABLE", "STALE"],
          "description": "Excludes CONFIRMED for the same reason."
        },
        "canonicalReplayReasonCodes": { "type": "array", "items": { "type": "string" } },
        "reasonCodeDiff": {
          "type": "object",
          "required": ["onlyInCanonical", "onlyInConstructed"],
          "properties": {
            "onlyInCanonical": { "type": "array", "items": { "type": "string" } },
            "onlyInConstructed": { "type": "array", "items": { "type": "string" } }
          },
          "description": "Exactly which reasons the construction changed. It bounds the claim: everything NOT in this diff was unaffected."
        },
        "uiRequirement": { "type": "string", "minLength": 1 }
      }
    }
  }
}
