{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinjau.xyz/schemas/proof-of-protection/1.0.0.json",
  "title": "Tinjau Proof of Protection",
  "description": "Observed and replayed outcome document (tracker §0.13 and §0.24). `three-policy-comparison.json` is the instance of this schema. The schema is deliberately STRICT on the fields that carry a truth claim — the claim gate, the metric bases, the observed-vs-counterfactual marker on every metric, the data limitations — and permissive on the numeric detail beneath them. A schema cannot check whether a number is right; it can check that no number is published without saying whether it was observed or imagined, and that no claim is published without its gate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentId",
    "producedByTasks",
    "derivedFrom",
    "method",
    "interpretation",
    "headlineFindings",
    "eventSelection",
    "replayInputs",
    "observedProtectedPoolResult",
    "results",
    "comparisonCells",
    "claimEligibility",
    "dataLimitations"
  ],
  "properties": {
    "schemaVersion": { "const": "tinjau.proof-of-protection/1.0.0" },
    "documentId": { "type": "string", "minLength": 1 },
    "producedByTasks": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "derivedFrom": {
      "type": "object",
      "required": ["file", "schemaVersion", "note"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "schemaVersion": { "type": "string", "minLength": 1 },
        "narrative": { "type": "string" },
        "note": { "type": "string", "minLength": 1 }
      }
    },

    "method": {
      "type": "object",
      "required": [
        "preRegistration",
        "identicalInput",
        "policies",
        "kGrid",
        "minDrawdownBpsGrid",
        "amendments",
        "metricBases"
      ],
      "properties": {
        "preRegistration": {
          "type": "object",
          "required": ["schemaVersion", "frozenAt", "document"],
          "properties": {
            "schemaVersion": { "type": "string", "minLength": 1 },
            "frozenAt": { "type": "string", "minLength": 1 },
            "document": { "type": "string", "minLength": 1 }
          }
        },
        "identicalInput": {
          "type": "string",
          "minLength": 1,
          "description": "§0.13 requires all three policies to receive identical trades, timestamps, liquidity, costs and window. This states how a reader checks that, rather than asking them to take it on trust."
        },
        "policies": {
          "type": "object",
          "additionalProperties": false,
          "required": ["STATIC", "VOLATILITY_ONLY", "TINJAU"],
          "properties": {
            "STATIC": { "$ref": "#/$defs/policyDescriptor" },
            "VOLATILITY_ONLY": { "$ref": "#/$defs/policyDescriptor" },
            "TINJAU": { "$ref": "#/$defs/policyDescriptor" }
          }
        },
        "kGrid": { "type": "array", "minItems": 2, "items": { "type": "integer" } },
        "minDrawdownBpsGrid": { "type": "array", "minItems": 2, "items": { "type": "integer" } },
        "amendments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "summary", "direction", "claimGateEffect"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "summary": { "type": "string", "minLength": 1 },
              "direction": {
                "type": "string",
                "minLength": 1,
                "description": "The amendment's direction of effect, which must be stated BEFORE its values. An amendment whose direction is not disclosed cannot be distinguished from result-fitting."
              },
              "claimGateEffect": { "type": "string", "minLength": 1 }
            }
          }
        },
        "metricBases": {
          "type": "array",
          "minItems": 2,
          "description": "At least two bases must be published. A single basis on this benchmark would pick a winner by choosing an arithmetic convention.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "metric", "preRegistered", "governsClaimGate", "knownDefect"],
            "properties": {
              "id": { "enum": ["PRE_REGISTERED", "AMD_002_CONSISTENT"] },
              "metric": { "type": "string", "minLength": 1 },
              "preRegistered": { "type": "boolean" },
              "governsClaimGate": { "type": "boolean" },
              "knownDefect": {
                "type": "string",
                "minLength": 1,
                "description": "Every basis here has one. Publishing a metric without naming its bias is how a bracketed result gets read as a measurement."
              }
            }
          }
        }
      }
    },

    "interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headline",
        "text",
        "whatItCanDetermine",
        "defensibleClaim",
        "prohibited"
      ],
      "properties": {
        "headline": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "whatItCanDetermine": { "type": "string", "minLength": 1 },
        "defensibleClaim": {
          "type": "string",
          "minLength": 1,
          "description": "The claim this document actually supports. It is behavioural, not economic."
        },
        "prohibited": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Claims this document does NOT support, listed so a copywriter does not have to infer them."
        }
      }
    },

    "headlineFindings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },

    "eventSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disclosure", "document", "scenarios"],
      "description": "§0.24 requires event-selection disclosure. A benchmark whose event set was chosen after seeing results is not a benchmark.",
      "properties": {
        "disclosure": { "type": "string", "minLength": 1 },
        "document": { "type": "string", "minLength": 1 },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scenarioId", "role", "preRegisteredState", "hasEconomicRow"],
            "properties": {
              "scenarioId": { "type": "string", "minLength": 1 },
              "role": {
                "enum": [
                  "RUMOUR_NEGATIVE_CONTROL",
                  "NEUTRAL_CONTROL",
                  "MATERIAL_OFFICIAL_EVENT",
                  "AMBIGUOUS_TWO_ORIGIN_BOUNDARY"
                ],
                "description": "§0.13 requires neutral and false-rumour cases, not only dramatic negative events."
              },
              "preRegisteredState": { "type": "string", "minLength": 1 },
              "hasEconomicRow": { "type": "boolean" }
            }
          }
        }
      }
    },

    "replayInputs": {
      "type": "array",
      "minItems": 1,
      "description": "§0.24: input/replay identity. The fingerprint is what proves the three policies saw the same input.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenarioId",
          "replayInputFingerprint",
          "windowFromBlock",
          "windowToBlock",
          "swapCount",
          "rpcRangeErrors",
          "hasEconomicRow"
        ],
        "properties": {
          "scenarioId": { "type": "string", "minLength": 1 },
          "replayInputFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "windowFromBlock": { "type": "integer", "minimum": 0 },
          "windowToBlock": { "type": "integer", "minimum": 0 },
          "swapCount": { "type": "integer", "minimum": 0 },
          "rpcRangeErrors": {
            "type": "integer",
            "minimum": 0,
            "description": "Non-zero makes the swap total a LOWER BOUND. It is carried rather than hidden."
          },
          "hasEconomicRow": { "type": "boolean" }
        }
      }
    },

    "observedProtectedPoolResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exists", "reason", "onlyProtectedIntervalAnywhere"],
      "description": "§0.24 requires the observed protected-pool result. When there is none, saying so explicitly is the honest form of that field — an absent section would read as an oversight.",
      "properties": {
        "exists": {
          "const": false,
          "description": "Constrained to false. Tinjau reaches PROTECT on none of the four frozen replay scenarios, so no protected interval exists on a real market. If that ever changes, this schema must be versioned rather than edited — the change is exactly the kind that must not pass silently."
        },
        "reason": { "type": "string", "minLength": 1 },
        "onlyProtectedIntervalAnywhere": {
          "type": "object",
          "additionalProperties": false,
          "required": ["where", "artifact", "marketLeg", "warning"],
          "properties": {
            "where": { "type": "string", "minLength": 1 },
            "artifact": { "type": "string", "minLength": 1 },
            "marketLeg": { "const": "CONSTRUCTED" },
            "warning": { "type": "string", "minLength": 1 }
          }
        }
      }
    },

    "results": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/policyResult" }
    },

    "comparisonCells": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/comparisonCell" }
    },

    "claimEligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "value",
        "metricBasis",
        "amd002Excluded",
        "conditions",
        "failedConditionIds",
        "summary",
        "reason"
      ],
      "properties": {
        "field": { "const": "canClaimLossAvoided" },
        "value": {
          "const": false,
          "description": "Constrained to false at the schema level. Tinjau TIES STATIC on the pre-registered metric and 'beats' means strictly greater, so the gate is closed. Opening it requires a new benchmark run AND a schema version bump — it may not become true by editing a JSON file."
        },
        "metricBasis": {
          "const": "PRE_REGISTERED",
          "description": "The gate reads the pre-registered metric alone. A metric derived after seeing results cannot authorise a claim, or the pre-registration would be decorative."
        },
        "amd002Excluded": { "type": "string", "minLength": 1 },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text", "passed", "detail"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 },
              "passed": {
                "type": ["boolean", "null"],
                "description": "null means not evaluable — either an earlier condition failed, or the condition is a process fact no code can check. Reported as null rather than dressed up as a machine check."
              },
              "detail": { "type": "string", "minLength": 1 }
            }
          }
        },
        "failedConditionIds": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },

    "dataLimitations": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string", "minLength": 1 },
      "description": "§0.24 requires data limitations. minItems is deliberately non-zero: this benchmark has known, published biases and an empty list would be false."
    }
  },

  "$defs": {
    "policyId": { "enum": ["STATIC", "VOLATILITY_ONLY", "TINJAU"] },
    "basis": {
      "enum": ["OBSERVED", "COUNTERFACTUAL"],
      "description": "§0.24's observed-versus-counterfactual marker. Every numeric metric carries one. A UI must never give the two the same visual treatment."
    },
    "policyDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["methodVersion", "description", "parameters"],
      "properties": {
        "methodVersion": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "parameters": { "type": "array", "minItems": 1, "items": { "type": "object" } }
      }
    },
    "metric": {
      "type": "object",
      "required": ["value", "unit", "basis"],
      "properties": {
        "value": { "type": ["number", "null"] },
        "unit": { "type": "string", "minLength": 1 },
        "basis": { "$ref": "#/$defs/basis" },
        "note": { "type": "string" }
      }
    },
    "distribution": {
      "type": "object",
      "required": ["count", "min", "p25", "median", "p75", "max", "mean", "sum", "method"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "min": { "type": ["number", "null"] },
        "p25": { "type": ["number", "null"] },
        "median": { "type": ["number", "null"] },
        "p75": { "type": ["number", "null"] },
        "max": { "type": ["number", "null"] },
        "mean": { "type": ["number", "null"] },
        "sum": { "type": ["number", "null"] },
        "method": {
          "type": "string",
          "minLength": 1,
          "description": "Quantile method, stated because p25 and the median of an even-length sample are method-dependent."
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "swapCount",
        "rpcRangeErrors",
        "totalNotionalUsd",
        "feeRevenueGrossUsd",
        "feeRevenueToLpUsd",
        "protocolHaircutUsd",
        "primaryHorizonSec",
        "markoutM0Usd",
        "markoutPrimaryUsd",
        "markoutPrimaryBpsOfNotional",
        "markoutPrimaryBpsOfTvl",
        "adverseSelectionPrimaryUsd",
        "distributionPrimaryUsd",
        "tailConcentration",
        "amd002ConsistentBasis"
      ],
      "properties": {
        "swapCount": { "type": "integer", "minimum": 0 },
        "rpcRangeErrors": { "type": "integer", "minimum": 0 },
        "totalNotionalUsd": { "$ref": "#/$defs/metric" },
        "feeRevenueGrossUsd": { "$ref": "#/$defs/metric" },
        "feeRevenueToLpUsd": { "$ref": "#/$defs/metric" },
        "protocolHaircutUsd": { "$ref": "#/$defs/metric" },
        "primaryHorizonSec": { "type": "integer", "minimum": 0 },
        "markoutM0Usd": { "$ref": "#/$defs/metric" },
        "markoutPrimaryUsd": { "$ref": "#/$defs/metric" },
        "markoutPrimaryBpsOfNotional": { "$ref": "#/$defs/metric" },
        "markoutPrimaryBpsOfTvl": { "$ref": "#/$defs/metric" },
        "adverseSelectionPrimaryUsd": { "$ref": "#/$defs/metric" },
        "markoutByHorizonUsd": { "type": "object", "additionalProperties": { "$ref": "#/$defs/metric" } },
        "distributionPrimaryUsd": { "$ref": "#/$defs/distribution" },
        "tailConcentration": { "type": "object" },
        "tvlEventUsd": { "$ref": "#/$defs/metric" },
        "amd002ConsistentBasis": {
          "type": "object",
          "required": ["_amendment", "_label", "_mayOpenClaimGate", "markoutPrimaryConsistentUsd"],
          "properties": {
            "_amendment": { "const": "AMD-002" },
            "_label": { "const": "POST_HOC_AMENDMENT" },
            "_notPreRegistered": { "type": "string" },
            "_direction": { "type": "string" },
            "_mayOpenClaimGate": { "const": false },
            "observedFeeRevenueGrossUsd": { "$ref": "#/$defs/metric" },
            "feeUpliftUsd": { "$ref": "#/$defs/metric" },
            "markoutPrimaryConsistentUsd": { "$ref": "#/$defs/metric" },
            "markoutPrimaryConsistentBpsOfNotional": { "$ref": "#/$defs/metric" },
            "markoutPrimaryConsistentBpsOfTvl": { "$ref": "#/$defs/metric" },
            "markoutByHorizonConsistentUsd": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/metric" }
            },
            "distributionPrimaryConsistentUsd": { "$ref": "#/$defs/distribution" }
          }
        }
      }
    },
    "policyResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioId",
        "policyId",
        "parameters",
        "methodVersion",
        "replayInputFingerprint",
        "metrics",
        "behaviour",
        "notes"
      ],
      "properties": {
        "scenarioId": { "type": "string", "minLength": 1 },
        "policyId": { "$ref": "#/$defs/policyId" },
        "parameters": { "type": "object" },
        "methodVersion": { "type": "string", "minLength": 1 },
        "replayInputFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "metrics": {
          "oneOf": [{ "$ref": "#/$defs/metrics" }, { "type": "null" }],
          "description": "null when the scenario carries no economic row. Null is reported, never dropped or imputed."
        },
        "behaviour": { "$ref": "#/$defs/behaviour" },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "behaviour": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "statusReason",
        "triggerCount",
        "episodes",
        "actionLatencySec",
        "maxFeeReachedPips",
        "protectionDurationSec",
        "timeToDecaySec",
        "falsePositive",
        "falseNegative"
      ],
      "description": "What the benchmark CAN determine regardless of metric basis: whether a policy fired, when, on what, and whether the event warranted it.",
      "properties": {
        "status": { "type": "string", "minLength": 1 },
        "statusReason": { "type": "string", "minLength": 1 },
        "triggerCount": { "type": "integer", "minimum": 0 },
        "episodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["triggerAtUnixSeconds", "recoveredAtUnixSeconds"],
            "properties": {
              "triggerAtUnixSeconds": { "type": "integer" },
              "recoveredAtUnixSeconds": { "type": ["integer", "null"] }
            }
          }
        },
        "actionLatencySec": { "$ref": "#/$defs/metric" },
        "maxFeeReachedPips": { "$ref": "#/$defs/metric" },
        "protectionDurationSec": { "$ref": "#/$defs/metric" },
        "timeToDecaySec": { "$ref": "#/$defs/metric" },
        "falsePositive": { "$ref": "#/$defs/errorLabel" },
        "falseNegative": { "$ref": "#/$defs/errorLabel" }
      }
    },
    "errorLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "fired", "costUsd", "reason"],
      "properties": {
        "label": {
          "enum": [
            "FALSE_POSITIVE",
            "FALSE_NEGATIVE",
            "TRUE_POSITIVE",
            "TRUE_NEGATIVE",
            "NO_ECONOMIC_ROW",
            "NOT_DETERMINABLE"
          ],
          "description": "NOT_DETERMINABLE means the pre-registration does not supply the judgement needed to label this cell. It is distinct from TRUE_NEGATIVE ('the policy correctly did nothing') and from NO_ECONOMIC_ROW ('there were no trades to cost'). Collapsing the three would hide which of them applies."
        },
        "fired": { "type": "boolean" },
        "costUsd": { "$ref": "#/$defs/metric" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "comparisonCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioId",
        "k",
        "minDrawdownBps",
        "metric",
        "metricBasis",
        "unit",
        "basis",
        "staticUsd",
        "volatilityOnlyUsd",
        "tinjauUsd",
        "volatilityStatus",
        "tinjauState",
        "vsStatic",
        "vsVolatilityOnly",
        "note"
      ],
      "description": "One head-to-head cell at one (scenario, k, minDrawdownBps, metric basis). Both bases are published for every cell; all 27 comparable cells flip sign between them, which is why neither may be quoted alone.",
      "properties": {
        "scenarioId": { "type": "string", "minLength": 1 },
        "k": { "type": "integer" },
        "minDrawdownBps": { "type": "integer" },
        "metric": { "type": "string", "minLength": 1 },
        "metricBasis": { "enum": ["PRE_REGISTERED", "AMD_002_CONSISTENT"] },
        "unit": { "type": "string", "minLength": 1 },
        "basis": { "$ref": "#/$defs/basis" },
        "staticUsd": { "type": ["number", "null"] },
        "volatilityOnlyUsd": { "type": ["number", "null"] },
        "tinjauUsd": { "type": ["number", "null"] },
        "volatilityStatus": { "type": "string", "minLength": 1 },
        "tinjauState": { "enum": ["NORMAL", "WATCH", "PROTECT"] },
        "vsStatic": { "$ref": "#/$defs/comparisonVerdict" },
        "vsVolatilityOnly": { "$ref": "#/$defs/comparisonVerdict" },
        "note": { "type": "string" }
      }
    },
    "comparisonVerdict": {
      "enum": ["TINJAU_BEATS", "TINJAU_TIES", "TINJAU_LOSES", "NOT_COMPARABLE"],
      "description": "TINJAU_TIES is not a win. §0.13 forbids hiding a result in which a baseline performs as well as or better than Tinjau, so TINJAU_LOSES is a value this vocabulary must be able to express and does."
    }
  }
}
