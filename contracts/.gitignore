# Foundry build artifacts — rebuildable, never commit
cache/
out/

# Dependencies are VENDORED, not ignored. `lib/` is committed on purpose so that
# `git clone && cd contracts && forge test` works with no further steps. See
# lib/VENDORED.md for the upstream revisions and the reason submodules were rejected.
# Do not re-add `lib/` here, and do not run `forge install` — it would overwrite the
# pinned sources with whatever upstream HEAD happens to be.

# Local machine state
.DS_Store

# broadcast/ is intentionally NOT ignored — transaction receipts (tx hash, deployed address)
# are public on-chain data anyway and serve as reproducible deployment evidence for the
# task-tracker.md evidence lines and the hackathon submission.
