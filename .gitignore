# Machine/local state — never commit
.DS_Store
.env
.env.*
!.env.example
node_modules/
.secrets/

# Local tool state (not part of the AFTERHOURS deliverable)
.impeccable/
.superstack/
.superpowers/

# contracts/ was previously its own independent git repo, excluded from here and
# intended for a separate GitHub repo linked from the README. That separation was
# reversed on 2026-08-21: it meant a judge cloning this repository received zero
# Solidity, no deployment receipts, and could not run `forge test`. The source is
# ~340 KB; contracts/.gitignore already excludes lib/, out/ and cache/, so only
# src/, test/, script/ and broadcast/ are committed here.
contracts/lib/
contracts/out/
contracts/cache/

# Build artifacts
apps/*/dist/
apps/*/.next/
apps/*/out/
*.tsbuildinfo
.vercel
.env*
