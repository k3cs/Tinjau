# Machine/local state — never commit
.DS_Store
.env
.env.*
!.env.example
node_modules/
.secrets/

# Local tool state (not part of the AFTERHOURS deliverable)
.impeccable/
.superstack/
.superpowers/

# contracts/ was previously its own independent git repo, excluded from here and
# intended for a separate GitHub repo linked from the README. That separation was
# reversed on 2026-08-21: it meant a judge cloning this repository received zero
# Solidity, no deployment receipts, and could not run `forge test`.
#
# contracts/lib/ stayed excluded after that reversal, which left the same hole one level
# down: `forge test` still failed on a bare clone, because no dependency revision was
# pinned anywhere public. Since 2026-08-21 the dependency sources are vendored and
# committed. contracts/lib/VENDORED.md records the exact upstream revisions and why
# git submodules were rejected. Only rebuildable output stays ignored.
contracts/out/
contracts/cache/

# Build artifacts
apps/*/dist/
apps/*/.next/
apps/*/out/
*.tsbuildinfo
.vercel
.env*

# Local Anvil (chain 31337) deploy artifacts. `run-latest.json` is tracked as the
# pointer; the timestamped siblings are regenerated on every harness run and are
# pure churn in the diff.
contracts/broadcast/**/31337/run-[0-9]*.json
